# Copy to .env and fill in. .env is gitignored.

ENVIRONMENT=local
LOG_LEVEL=INFO

# SQLAlchemy async URL (asyncpg driver) — used by the FastAPI runtime.
# Local default matches docker-compose. In production, use your provider's URL
# in async form (e.g. Neon: postgresql+asyncpg://…?ssl=require).
DATABASE_URL=postgresql+asyncpg://artlas:artlas@localhost:5432/artlas

# Sync URL used by Alembic migrations (psycopg driver). Same DB, different
# Python driver. In production: swap the scheme to postgresql+psycopg and
# change `ssl=require` back to `sslmode=require`.
SYNC_DATABASE_URL=postgresql+psycopg://artlas:artlas@localhost:5432/artlas

# JWT — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated origins for the frontend
CORS_ORIGINS=http://localhost:5173
